{
  "model": {
    "architecture": "hybrid_deepfake_detector",
    "backbone": "efficientnet-b4",
    "image_size": 224,
    "num_classes": 1,
    "dropout": 0.3
  },
  "training": {
    "batch_size": 32,
    "learning_rate": 0.001,
    "epochs": 50,
    "weight_decay": 1e-4,
    "scheduler": "cosine",
    "warmup_epochs": 5
  },
  "data": {
    "train_split": 0.8,
    "val_split": 0.2,
    "num_workers": 4,
    "pin_memory": true
  },
  "features": {
    "use_pixel_analysis": true,
    "use_compression_detection": true,
    "use_frequency_analysis": true,
    "use_face_landmarks": true
  },
  "paths": {
    "data_dir": "./datasets",
    "model_dir": "./models",
    "logs_dir": "./logs",
    "checkpoints_dir": "./checkpoints"
  }
}
